{
  "name": "visual-qa-agent",
  "version": "1.0.0",
  "description": "CLI tool for visual regression testing using Playwright screenshots",
  "main": "dist/cli.js",
  "bin": {
    "visual-qa-agent": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "visual-regression",
    "screenshot",
    "testing",
    "playwright",
    "qa"
  ],
  "author": "Eli Benveniste",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.7.2"
  }
}
